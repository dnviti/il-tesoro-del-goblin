t_style":"Regular","size":7.086625,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.16470589,"g":0.12941177,"b":0.09411765}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":392,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,36.850392401218414,1145.7637848973272],"runs":[{"text":"Livello su: +1 ATT, MOV o AR oppure +2 PV (gira PV e PV max). Equipaggi o perdi un oggetto: gira subito le rotelle.","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.086625,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.16470589,"g":0.12941177,"b":0.09411765}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":393,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,36.850392401218414,1155.9685089468958],"runs":[{"text":"Fine del turno: togli gli stati dritti, raddrizza quelli di traverso, togli gli Usato «una volta per turno».","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.086625,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.16470589,"g":0.12941177,"b":0.09411765}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"sp