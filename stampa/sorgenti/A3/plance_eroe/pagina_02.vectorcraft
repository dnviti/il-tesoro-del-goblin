.850392401218414,551.6220735669136],"runs":[{"text":"Si parte da PV 5 · PV max 5 · ATT 1 · MOV 1 · AR 9 · PE 0, poi aggiungi il bonus della Carta Specie.","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.086625,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.16470589,"g":0.12941177,"b":0.09411765}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":115,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,36.850392401218414,561.8267976164817],"runs":[{"text":"Livello su: +1 ATT, MOV o AR oppure +2 PV (gira PV e PV max). Equipaggi o perdi un oggetto: gira subito le rotelle.","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.086625,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.16470589,"g":0.12941177,"b":0.09411765}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":116,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,36.850392401218414,572.03152166605],"runs":[{"text":"Fine del turno: togli gli stati dritti, raddrizza quelli di traverso, togli gli Usato «una volta per turno».","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.086625,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.16470589,"g":0.12941177,"b":0.09411765}},"stroke":