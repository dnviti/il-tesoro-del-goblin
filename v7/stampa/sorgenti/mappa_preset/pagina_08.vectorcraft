e,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":586,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,39.6850608587265,616.2802932268381],"runs":[{"text":"Se il fiore indicato sta in un altro spazio, scambialo con quello dello spazio indicato: il fiore tolto va nello spazio liberato con la sua faccia e la sua freccia. Poi metti faccia e freccia","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.9370199999999995,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":587,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,39.6850608587265,626.34328499794],"runs":[{"text":"indicate. Vale anche dopo un draft.","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.9370199999999995,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":588,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,39.6850608587265,636.4346232247353],"runs":[{"text":"Prima del cambio: i Â«?Â» e le tessere sui fiori che si muovono tornano nella riserva; chi ha giocato la carta li rimette sui fiori nuovi, su esagoni percorribili ad almeno 2 esagoni dalle","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.9370199999999995,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":589,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,39.6850608587265,646.5259614515305],"runs":[{"text":"Partenze. Poi la Cripta si ritira con 2D6 + 2D6.","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.9370199999999995,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}}]}}],"swatches":[{"name":"[None]","paint":{"type":"none"},"global":false,"spot":false},{"name":"White","paint":{"type":"solid","color":{"model":"rgb","r":1.0,"g":1.0,"b":1.0}},"global":false,"spot":false},{"name":"Black","paint":{"type":"solid","color":{"model":"rgb","r":0.0,"g":0.0,"b":0.0}},"global":false,"spot":false},{"name":"Red","paint":{"type":"solid","color":{"model":"rgb","r":0.92941177,"g":0.10980392,"b":0.14117648}},"global":false,"spot":false},{"name":"Orange Red","paint":{"type":"solid","color":{"model":"rgb","r":0.94509804,"g":0.3529412,"b":0.14117648}},"global":false,"spot":false},{"name":"Orange","paint":{"type":"solid"