:"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,39.6850608587265,599.2724198108912],"runs":[{"text":"1) spazio 12 â† 13A, freccia 3 Â· 2) spazio 7 â† 6A, freccia 4 Â· 3) spazio 3 â† 10B, freccia 6","style":{"font_family":"Liberation Sans Narrow","font_style":"Bold","size":9.63781,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.16470589,"g":0.12941177,"b":0.09411765}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":887,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,39.6850608587265,616.2802932268381],"runs":[{"text":"Se il fiore indicato sta in un altro spazio, scambialo con quello dello spazio indicato: il fiore tolto va nello spazio liberato con la sua faccia e la sua freccia. Poi metti faccia e freccia","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.9370199999999995,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":888,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,39.6850608587265,626.34328499794],"runs":[{"text":"indicate. Vale anche dopo un draft.","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.9370199999999995,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":889,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,39.6850608587265,636.4346232247353],"runs":[{"text":"Prima del cambio: le tessere sui fiori che si muovono tornano coperte nella riserva; chi ha giocato la carta ne rimette altrettante coperte dalla riserva sui fiori nuovi, una per","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.9370199999999995,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":890,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,39.6850608587265,646.5259614515305],"runs":[{"text":"esagono, su esagoni percorribili ad almeno 2 esagoni dalle Partenze. Poi la Cripta si ritira con 2D6 + 2D6.","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.9370199999999995,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}}]}}],"swatches":[{"name":"[None]","pai