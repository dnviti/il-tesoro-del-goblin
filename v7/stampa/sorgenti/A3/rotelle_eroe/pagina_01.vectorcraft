avolo.","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.37009,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":726,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,429.44880375266075,1070.362212753296],"runs":[{"text":"Stampa al 100%. Ritaglia ogni disco dove cambia il colore e la finestra bianca; fora il centro con un punteruolo.","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.37009,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":727,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,429.44880375266075,1082.551188701391],"runs":[{"text":"Disco sopra la corona con lo stesso nome (plancia eroe o Sala del Tesoro), fermacampioni dal davanti, gambe","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.37009,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0