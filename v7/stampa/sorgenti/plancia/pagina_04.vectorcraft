41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Center","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":547,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,297.6378076672554,785.1968227028847],"runs":[{"text":"Una plancia in 4 fogli A4. Mappa: bozza v7 per il playtest (10 Ã— 10 esagoni, girata di 180Â° Ã¨ identica).","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.37009,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.41960785,"g":0.2901961,"b":0.16862746}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Center","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}}]}}],"swatches":[{"name":"[None]","paint":{"type":"none"},"global":false,"spot":false},{"name":"White","paint":{"type":"solid","color":{"model":"rgb","r":1.0,"g":1.0,"b":1.0}},"global":false,"spot":false},{"name":"Black","paint":{"type":"solid","color":{"model":"rgb","r":0.0,"g":0.0,"b":0.0}},"global":false,"spot":false},{"name":"Red","paint":{"type":"solid","color":{"model":"rgb","r":0.92941177,"g":0.10980392,"b":0.14117648}},"global":false,"spot":false},{"name":"Orange Red","paint":{"type":"solid","color":{"model":"rgb","r":0.94509804,"g":0.3529412,"b":0.14117648}},"global":false,"spot":false},{"name":"Orange","paint":{"type":"solid","color":{"model":"rgb","r":0.96862745,"g":0.5764706,"b":0.11764706}},"global":false,"spot":false},{"name":"Amber","paint":{"type":"solid","color":{"model":"rgb","r":0.9843137,"g":0.6901961,"b":0.23137255}},"global":false,"spot":false},{"name":"Yellow","paint":{"type":"solid","color":{