,"appearance":{"items":[{"kind":"fill","paint":{"type":"solid","color":{"model":"rgb","r":0.0,"g":0.0,"b":0.0}}},{"kind":"stroke","paint":{"type":"solid","color":{"model":"rgb","r":0.0,"g":0.0,"b":0.0}},"width":0.42519685229447823,"miter_limit":4.0}]},"kind":{"type":"path","path":{"subpaths":[{"anchors":[{"p":[568.3464595377445,688.8188733458519]},{"p":[576.850396245718,688.8188733458519]}],"closed":false}]}}}],"clip":false}},{"id":542,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,297.6378076672554,714.3306834697723],"runs":[{"text":"PLANCIA Â«Le Terre di HandeÂ» v7 Â· foglio 4 di 4 (basso a destra)","style":{"font_family":"Liberation Serif","font_style":"Bold","size":11.3386,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.16470589,"g":0.12941177,"b":0.09411765}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Center","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":543,"kind":{"type":"text","kind":{"kind":"point"},"xf":[0.9999984369585289,0.0,0.0,0.9999984369585289,297.6378076672554,731.3385568857193],"runs":[{"text":"Taglia i margini bianchi a SINISTRA e in ALTO lungo le tacche. Sovrapponilo agli angoli dei fogli 2 (fascia in basso) e 3 (fascia a destra).","style":{"font_family":"Liberation Sans Narrow","font_style":"Regular","size":7.9370199999999995,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"rgb","r":0.16470589,"g":0.12941177,"b":0.09411765}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Center","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":544,